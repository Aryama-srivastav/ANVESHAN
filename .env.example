# Database
DATABASE_URL=******HOST:5432/ANVESHAN_DB

# Application security
APP_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
APP_ENV=development

# Authentication / authorization
AUTH_PROVIDER=supabase
AUTH_CLIENT_ID=REPLACE_WITH_CLIENT_ID
AUTH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
JWT_SECRET=REPLACE_WITH_SUPABASE_JWT_SECRET
REQUIRE_MFA=true

# Object storage (use local for development; supabase requires the service URL/key)
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_DIR=backend/uploads
SUPABASE_URL=https://REPLACE_WITH_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_KEY
SUPABASE_STORAGE_BUCKET=anveshan-evidence
DOCUMENT_ENCRYPTION_ENABLED=true
# 32-byte URL-safe base64 encryption key. Required when APP_ENV=production.
DOCUMENT_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Digital signing: persist this key in a secret manager in production.
SIGNING_PRIVATE_KEY_PEM=
SIGNING_KEY_PATH=backend/keys/document-signing-key.pem

# Blockchain: use local only for development; fabric requires a deployed REST gateway.
BLOCKCHAIN_PROVIDER=local
FABRIC_GATEWAY_URL=
FABRIC_GATEWAY_TOKEN=

# AI / LLM provider
LLM_PROVIDER=REPLACE_WITH_PROVIDER
LLM_API_KEY=REPLACE_WITH_API_KEY
LLM_MODEL=REPLACE_WITH_MODEL_NAME

# Vector database
VECTOR_DB_PROVIDER=REPLACE_WITH_PROVIDER
VECTOR_DB_URL=https://REPLACE_WITH_VECTOR_DB_URL
VECTOR_DB_API_KEY=REPLACE_WITH_VECTOR_DB_API_KEY

# Search service
SEARCH_PROVIDER=REPLACE_WITH_PROVIDER
SEARCH_URL=https://REPLACE_WITH_SEARCH_URL
SEARCH_API_KEY=REPLACE_WITH_SEARCH_API_KEY
