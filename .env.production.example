# ANVESHAN V1 — production environment template.
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production up --build -d
#
# Never commit .env.production. Every value marked REQUIRED must be replaced;
# generate secrets with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# ── PostgreSQL (docker compose database service) ────────────────────────────
POSTGRES_DB=anveshan
POSTGRES_USER=anveshan
POSTGRES_PASSWORD=REQUIRED_STRONG_DB_PASSWORD

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=REQUIRED_STRONG_RANDOM_SECRET
# HS256 signing key for API access tokens (32+ bytes of entropy).
JWT_SECRET=REQUIRED_STRONG_JWT_SECRET
# Production must keep MFA enforcement on.
REQUIRE_MFA=true
# Browser origins allowed to call the API (comma separated, no trailing slash).
CORS_ORIGINS=http://localhost:8080

# ── Evidence encryption at rest (AES-256-GCM) ──────────────────────────────
DOCUMENT_ENCRYPTION_ENABLED=true
# REQUIRED: 32-byte URL-safe base64 key. Losing this key makes evidence unreadable.
DOCUMENT_ENCRYPTION_KEY=REQUIRED_32_BYTE_BASE64_KEY

# ── Blockchain audit trail ─────────────────────────────────────────────────
# "local" = hash-chained PostgreSQL ledger (verifiable, tamper-evident).
# "fabric" = commit each record hash to a Hyperledger Fabric REST gateway.
BLOCKCHAIN_PROVIDER=local
FABRIC_GATEWAY_URL=
FABRIC_GATEWAY_TOKEN=

# ── Government identity verification (optional integration) ────────────────
# GOV_ID_PROVIDER: "local" validates identifier format offline (demo/test),
# "http" calls the real agency endpoint below.
GOV_ID_PROVIDER=local
GOV_ID_API_URL=
GOV_ID_API_KEY=
GOV_ID_API_TIMEOUT=15

# ── Host ports ─────────────────────────────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000
# Baked into the frontend bundle at image build time.
VITE_API_URL=http://localhost:8000